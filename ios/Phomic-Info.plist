<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Phomic</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Phomic streams your iPhone's microphone to your Windows PC.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Phomic finds and connects to the Phomic app on computers on your local network.</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Phomic can stream your microphone to your PC over Bluetooth when Wi-Fi isn't available.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_phomic._tcp</string>
    </array>
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>bluetooth-central</string>
    </array>
    <key>UIRequiresPersistentWiFi</key>
    <true/>
    <key>NSSupportsLiveActivities</key>
    <true/>
    <!-- The icon: "AppIcon" in Assets.car (the icon in layers), and the plain picture for where
         that isn't read. Both are built from Resources/AppIcon.icon; see xtool.yml. -->
    <key>CFBundleIcons</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconFiles</key>
            <array>
                <string>AppIcon60x60</string>
            </array>
            <key>CFBundleIconName</key>
            <string>AppIcon</string>
        </dict>
    </dict>
    <!-- No encryption beyond what iOS itself provides (App Store export compliance). -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
