  <!--
    Release builds are published, so they mustn't carry the build machine's paths
    (C:\Users\<name>\...): C++/WinRT records each call's source file for error messages
    (WINRT_NO_SOURCE_LOCATION turns that off), and the exe names its PDB by full path
    (/PDBALTPATH:%_PDB% keeps just the file name).
  -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;WINRT_NO_SOURCE_LOCATION;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <AdditionalOptions>/PDBALTPATH:%25_PDB%25 %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
