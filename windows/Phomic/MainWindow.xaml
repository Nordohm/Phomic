<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Phomic.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Phomic"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Phomic">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <ScrollViewer x:Name="RootScroller" VerticalScrollBarVisibility="Auto">
        <!--  Width set in code: at most 620, centered (see ResizeForDpi)  -->
        <StackPanel
            x:Name="RootPanel"
            Margin="24,20,24,24"
            HorizontalAlignment="Center"
            Spacing="12">

            <InfoBar
                x:Name="ErrorBar"
                IsClosable="True"
                Severity="Error"
                Visibility="Collapsed" />

            <InfoBar
                x:Name="MicBar"
                IsClosable="False"
                Visibility="Collapsed"
                Severity="Informational">
                <InfoBar.ActionButton>
                    <Button
                        x:Name="MicSetupButton"
                        HorizontalAlignment="Left"
                        Click="MicSetupButton_Click"
                        Style="{StaticResource AccentButtonStyle}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar
                x:Name="DefaultOutputBar"
                Visibility="Collapsed"
                Title="Your PC's sound is going into the microphone"
                IsClosable="True"
                Message="Windows uses “Phomic (internal)” as its default output, so everything you'd hear also goes into the Phomic microphone. Pick your speakers or headphones in Settings › System › Sound."
                Severity="Warning" />

            <!--  Connection  -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="48" Height="48" VerticalAlignment="Center">
                        <Grid x:Name="IdleBadge">
                            <Ellipse Fill="{ThemeResource ControlAltFillColorTertiaryBrush}" />
                            <FontIcon
                                FontSize="20"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE8EA;" />
                        </Grid>
                        <Grid x:Name="LiveBadge" Visibility="Collapsed">
                            <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                            <FontIcon
                                FontSize="20"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Glyph="&#xE720;" />
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            x:Name="StatusTitle"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Waiting for your iPhone"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="StatusDetail"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Button
                        x:Name="DisconnectButton"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Click="DisconnectButton_Click"
                        Content="Disconnect"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <!--  Wi-Fi and Bluetooth, side by side  -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Connection" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="One at a time. Pick Wi-Fi or Bluetooth in Phomic on the iPhone, or switch here while connected."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Width="24"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Glyph="&#xE701;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Wi-Fi" />
                            <TextBlock
                                x:Name="WiFiText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            x:Name="SwitchToWiFiButton"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Click="SwitchToWiFiButton_Click"
                            Content="Switch here"
                            Visibility="Collapsed" />
                        <ToggleSwitch
                            x:Name="WiFiToggle"
                            Grid.Column="3"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            OffContent=""
                            OnContent=""
                            Toggled="WiFiToggle_Toggled" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Width="24"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Glyph="&#xE702;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Bluetooth" />
                            <TextBlock
                                x:Name="BluetoothText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            x:Name="SwitchToBluetoothButton"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Click="SwitchToBluetoothButton_Click"
                            Content="Switch here"
                            Visibility="Collapsed" />
                        <ToggleSwitch
                            x:Name="BluetoothToggle"
                            Grid.Column="3"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            OffContent=""
                            OnContent=""
                            Toggled="BluetoothToggle_Toggled" />
                    </Grid>

                    <!--  A setting for both connections, not a third kind of connection  -->
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <CheckBox
                                x:Name="PairingCheck"
                                Click="PairingCheck_Click"
                                Content="Require a pairing code" />
                            <TextBlock
                                x:Name="PairingText"
                                Margin="28,-4,0,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <!--  The code itself, and a button for a new one  -->
                        <TextBlock
                            x:Name="PairingCodeText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Pairing code"
                            CharacterSpacing="200"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="NewCodeButton"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="New code"
                            Click="NewCodeButton_Click"
                            ToolTipService.ToolTip="New code (every iPhone asks for it again)"
                            Visibility="Collapsed">
                            <FontIcon FontSize="16" Glyph="&#xE72C;" />
                        </Button>
                    </Grid>

                    <StackPanel>
                        <HyperlinkButton
                            x:Name="DetailsButton"
                            Padding="0"
                            Click="DetailsButton_Click"
                            Content="Show details" />
                        <StackPanel
                            x:Name="DetailsPanel"
                            Margin="0,8,0,0"
                            Spacing="16"
                            Visibility="Collapsed">
                            <!--  Rows are label / value pairs, filled in by UpdateDetails  -->
                            <StackPanel x:Name="StreamSection" Spacing="6">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Stream" />
                                <Grid
                                    x:Name="StreamGrid"
                                    ColumnSpacing="16"
                                    RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="This PC" />
                                <Grid
                                    x:Name="PcGrid"
                                    ColumnSpacing="16"
                                    RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Level and gain  -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Microphone level" />
                        <TextBlock
                            x:Name="LevelText"
                            HorizontalAlignment="Right"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="" />
                    </Grid>
                    <Grid
                        Height="8"
                        Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                        CornerRadius="4">
                        <Border
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="4"
                            RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="LevelScale" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <Slider
                        x:Name="GainSlider"
                        Header="Gain"
                        Maximum="24"
                        Minimum="-12"
                        StepFrequency="1"
                        TickFrequency="6"
                        TickPlacement="Outside"
                        ValueChanged="GainSlider_ValueChanged" />
                </StackPanel>
            </Border>

            <!--  Output  -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <ComboBox
                        x:Name="OutputCombo"
                        HorizontalAlignment="Stretch"
                        Header="Play the iPhone's audio into"
                        PlaceholderText="No playback devices found"
                        SelectionChanged="OutputCombo_SelectionChanged" />
                    <ComboBox
                        x:Name="BufferCombo"
                        HorizontalAlignment="Stretch"
                        Header="Buffering"
                        SelectionChanged="BufferCombo_SelectionChanged">
                        <x:String>Auto – adapts to the connection</x:String>
                        <x:String>Low latency (30 ms)</x:String>
                        <x:String>Balanced (60 ms)</x:String>
                        <x:String>Stable (120 ms)</x:String>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!--  App  -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <CheckBox
                        x:Name="CloseToTrayCheck"
                        Click="CloseToTrayCheck_Click"
                        Content="Keep app running in tray when closing" />
                    <CheckBox
                        x:Name="StartupCheck"
                        Click="StartupCheck_Click"
                        Content="Launch app in tray when Windows starts" />
                </StackPanel>
            </Border>

            <!--  Footer: the support link. VB-CABLE's credit is under Show details (This PC).  -->
            <Grid Margin="16,0,4,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Phomic is free and open source."
                    TextWrapping="Wrap" />
                <HyperlinkButton
                    Grid.Column="1"
                    NavigateUri="https://buymeacoffee.com/nordohm"
                    ToolTipService.ToolTip="buymeacoffee.com/nordohm">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="☕" />
                        <TextBlock Text="Buy me a coffee" />
                    </StackPanel>
                </HyperlinkButton>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>
